# Feature Flag Environment Variables
# Copy this to your .env.local file and adjust as needed

# Skip membership status checks
FF_SKIP_MEMBERSHIP_CHECK=false

# Enable beta features for testing
FF_ENABLE_BETA_FEATURES=false

# Allow guest voting (for public elections)
FF_ALLOW_GUEST_VOTING=false

# Examples for different environments:

# Development
# FF_SKIP_MEMBERSHIP_CHECK=true
# FF_ENABLE_BETA_FEATURES=true

# Staging
# FF_SKIP_MEMBERSHIP_CHECK=false
# FF_ENABLE_BETA_FEATURES=true

# Production
# FF_SKIP_MEMBERSHIP_CHECK=false
# FF_ENABLE_BETA_FEATURES=false
