SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://127.0.0.1:54321/auth/v1/callback"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID="your-oauth-client-id"
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET="your-oauth-client-secret"

MY_EMAIL=you@example.com
MY_PASSWORD=your-app-password

# Mobile app deep links (docs/mobile-app-plan.md §3.3). Unset = /.well-known files answer 404.
# Apple Developer Team ID, for /.well-known/apple-app-site-association
APPLE_TEAM_ID=
# App signing SHA-256 from Play Console > App signing (comma-separated), for /.well-known/assetlinks.json
ANDROID_CERT_SHA256=

# Push notifications to the app (utils/push.ts). Server only; each platform is
# skipped until its values are set. APNs uses APPLE_TEAM_ID above.
# APNS_KEY: the .p8 key's contents (Apple Developer › Keys, with APNs enabled); \n for newlines is fine.
APNS_KEY=
APNS_KEY_ID=
# true for App Store and TestFlight builds; leave empty for Xcode development builds (sandbox).
APNS_PRODUCTION=
# FCM_SERVICE_ACCOUNT: the Firebase service account JSON (Project settings › Service accounts), on one line.
FCM_SERVICE_ACCOUNT=
