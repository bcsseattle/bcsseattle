{
  "name": "bcs-mobile",
  "private": true,
  "description": "BCS Seattle iOS and Android app (Capacitor). Next, React, Supabase and Tailwind come from the root package so the shared components and the app use one copy of each.",
  "scripts": {
    "dev": "node ../../node_modules/next/dist/bin/next dev -p 3200",
    "build": "node ../../node_modules/next/dist/bin/next build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "sync": "pnpm build && cap sync",
    "ios": "cap run ios",
    "android": "cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/text-zoom": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
