# Public values only: they are compiled into the app. next.config.mjs refuses
# to build if one of them is a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The website the app calls for /api/* and opens for payments.
NEXT_PUBLIC_SITE_URL=https://www.bcsseattle.org
# Android push needs the Firebase project's google-services.json in android/app/;
# set this to 1 only once it's there (register() crashes the app without it).
NEXT_PUBLIC_ANDROID_PUSH=
